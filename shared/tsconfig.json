{
    "compilerOptions": {
        "target": "es2023",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
