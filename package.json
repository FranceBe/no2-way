{
    "name": "no2-way",
    "private": true,
    "type": "module",
    "workspaces": [
        "shared",
        "backend",
        "frontend"
    ],
    "scripts": {
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "test": "npm run test:run -w backend && npm run test:unit -w frontend",
        "prepare": "husky",
        "coverage": "npm run coverage --workspaces --if-present"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.9",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.71.0"
    }
}
