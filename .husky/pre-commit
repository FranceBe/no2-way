# Git GUIs (VS Code, etc.) don't load the shell profile:
# use the Node version from .nvmrc when nvm is installed
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  . "$NVM_DIR/nvm.sh"
  nvm use --silent > /dev/null
fi

# Each staged file goes to the closest lint-staged.config.js (frontend/,
# backend/ or shared/), whose tasks run in that workspace
npx lint-staged
